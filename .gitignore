# ========================================================
# Next.js 16 + React 19 Project .gitignore
# ========================================================

# Dependencies
node_modules/
.pnp
.pnp.*
.yarn/**
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js Build Outputs & Cache
.next/
out/
build/
dist/
.turbo/

# Testing & Coverage
coverage/
*.lcov
.nyc_output/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Environment & Local Secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local
!.env.example

# Vercel Deployment
.vercel/

# TypeScript Build Cache
*.tsbuildinfo
next-env.d.ts

# OS Generated Files
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/

# IDE & Editor Configurations
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# Temporary & Certificate files
*.pem
*.key
*.cert
*.tmp
*.temp
*.bak
